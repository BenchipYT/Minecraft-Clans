DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chipnetworks"
# Nur Entwicklung: Seed-Admin
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-123"
# Phase 4 (serverseitig, niemals im Frontend):
# PTERODACTYL_URL=""
# PTERODACTYL_API_KEY=""
REDIS_URL="redis://localhost:6379"   # Worker: npm run worker
PTERO_NODE_ID=""        # Node für neue Server
PTERO_EGG_ID=""         # Paper-Egg
PTERO_DOCKER_IMAGE="ghcr.io/pterodactyl/yolks:java_21"
PTERO_STARTUP=""        # Startup-Befehl des Eggs
PTERO_ENV_JSON='{"MINECRAFT_VERSION":"latest","SERVER_JARFILE":"server.jar","BUILD_NUMBER":"latest"}' # Egg-Variablen anpassen
# CF_API_TOKEN="" CF_ZONE_ID="" BASE_DOMAIN="chipnetworks.de"   # optional: A-Record je Server
PTERODACTYL_CLIENT_KEY=""  # Client-API-Key eines Panel-Admins (sieht alle Server) für Start/Stopp, Status, Befehle
# E-Mail (SMTP). Ohne SMTP_HOST wird nichts gesendet, nur geloggt.
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"      # true bei Port 465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Chip Networks <noreply@deine-domain.de>"
TEAM_NOTIFY_EMAIL=""     # Team-Postfach für neue Bewerbungen, Tickets, Kontaktnachrichten
UPLOAD_DIR="./uploads"   # Ticket-Anhänge (außerhalb von public/); im Backup berücksichtigen

# Zahlungen (Mollie, Einmalzahlungen für Vorauszahlung): API-Key + öffentlich erreichbare APP_URL für den Webhook
MOLLIE_API_KEY=""
PAYMENT_METHODS="paysafecard,paypal,creditcard,banktransfer"   # nur in Mollie aktivierte Methoden
PAYMENT_FEES='{"paysafecard":{"percent":0,"fixedCents":0}}'     # Gebühren je Methode: Werte aus DEINEM Mollie-Vertrag eintragen
CRON_SECRET=""              # optional: POST /api/cron/expiry statt Worker
# Rechnungsangaben (VOR LIVEGANG prüfen lassen)
COMPANY_NAME="" 
COMPANY_ADDRESS=""
VAT_ID=""
VAT_PERCENT="0"             # 0 = Kleinunternehmer, sonst z. B. 19 (Preise gelten dann als Brutto)
INVOICE_TAX_NOTE="Kein Ausweis von Umsatzsteuer gemäß § 19 UStG."
# Rechtstexte: Firmenangaben für Impressum, AGB, Datenschutz, Widerruf (zusätzlich COMPANY_NAME/ADDRESS, VAT_ID, INVOICE_TAX_NOTE oben)
COMPANY_EMAIL=""
COMPANY_PHONE=""
COMPANY_REPRESENTATIVE=""    # bei juristischen Personen: Vertretungsberechtigte
COMPANY_REGISTER=""          # z. B. Amtsgericht ..., HRB ...
HOSTING_PROVIDER=""          # Anbieter, bei dem die Website läuft
MAIL_PROVIDER=""             # SMTP-Anbieter
DELETE_AFTER_DAYS="30"       # Frist nach Ablauf bis zur Löschung (AGB § 4)
LEGAL_REVIEWED="false"       # auf true setzen, sobald ein Anwalt die Texte geprüft hat (blendet den Entwurfshinweis aus)
